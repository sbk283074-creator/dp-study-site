# ---- Not part of the deployed static site ----
# Original full-stack platform (nested git repo, ~13 GB; deployed separately on Netlify)
dp learning/

# Agent / memory internals
.workbuddy-ai/

# OS junk
.DS_Store
Thumbs.db
*.swp
ehthumbs.db

# Stray Node modules
node_modules/

# ---- CODE micro-site (was the PYTHON micro-site) ----
# Built pages are committed: code/index.html (platform hub) and
# code/<lang>/index.html (one self-contained book per language).
# Chapter sources under code/<lang>/chapters/ are committed too -- they are the
# actual content and the only copy of it. Only the heavy local tooling is kept
# out of history.
code/verify-venv/
PYTHON/verify-venv/
PYTHON/.workbuddy/
code/.workbuddy/
code/**/.workbuddy/

# ---- Question Bank figures: served from external host (Internet Archive), not committed ----
qbank/figures/

# ---- Eng learning ("The World's Wife" Lit Lab) ----
# COMBINED into this repo (same repo, no submodule) and served from
# /Eng%20learning/ on the dp-study-site Pages site. Ignore only tooling memory:
Eng learning/.workbuddy/

# ---- Local scratch and run artefacts (not part of the deployed site) ----
# Underscore-prefixed names are the house convention for scratch: probe scripts,
# logs from one-off uploads, and figure exports. None of these are referenced by
# any tracked file. Keep them on disk; keep them out of history.
_figures_export/
_litfill/
_docx_read.py
.workbuddy/
tools/_*
tools/*.log
__pycache__/
*.pyc
